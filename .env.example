# ==============================================================================
# Deal Proposal Automation - Environment Configuration Template
# ==============================================================================
# The pipeline runs 100% offline using deterministic rule-based semantic extraction
# by default. To optionally enable frontier LLM extraction, configure any ONE of the
# following API keys below:

# Google Gemini API Key (Recommended - Free tier available at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional)
# OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (Optional)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
